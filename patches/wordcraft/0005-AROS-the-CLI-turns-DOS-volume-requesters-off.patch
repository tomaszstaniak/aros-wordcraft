From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Sat, 7 Nov 2026 10:34:04 +0100
Subject: [PATCH] AROS: the CLI turns DOS volume requesters off

Unix-style probes (/.flatpak-info for the control key, /usr and /opt data folders) name volumes that do not exist on AROS; each opened an "insert volume" requester that stopped the command until answered. aros-startup's quiet_dos makes DOS return an error instead, as the GUI does.
---
 apps/wordcraft-cli/Cargo.toml  | 2 ++
 apps/wordcraft-cli/src/main.rs | 4 ++++
 2 files changed, 6 insertions(+)

diff --git a/apps/wordcraft-cli/Cargo.toml b/apps/wordcraft-cli/Cargo.toml
index 041f455386fd8bf3d0050b448542ede10554ca7e..c9673f88dd986201dad0a98f492fbd66334bf104 100644
--- a/apps/wordcraft-cli/Cargo.toml
+++ b/apps/wordcraft-cli/Cargo.toml
@@ -26,6 +26,8 @@ sys-locale = "0.3"
 # which AROS's pthread library otherwise waits for forever when the program exits.
 [target.'cfg(target_os = "aros")'.dependencies]
 rayon-core = "1.13"
+# Program start on AROS (from the egui-aros repository, without egui), supplied by the port's build.
+aros-startup = "0.1"
 
 [dev-dependencies]
 wordcraft-fonts = { workspace = true }
diff --git a/apps/wordcraft-cli/src/main.rs b/apps/wordcraft-cli/src/main.rs
index fbe5b8144d4d28853c8dd0731ad25d4253edfeaf..e2a108dd12329fc7e031079b9e2e6eacf2c73320 100644
--- a/apps/wordcraft-cli/src/main.rs
+++ b/apps/wordcraft-cli/src/main.rs
@@ -916,6 +916,10 @@ fn parity_markdown(p: &Value) -> String {
 const AROS_STACK: usize = 8 << 20;
 
 fn main() -> ExitCode {
+    // AROS: the Unix-style probes (the Flatpak marker, /usr and /opt data folders) name volumes
+    // that do not exist; DOS answers them with an error instead of an "insert volume" requester.
+    #[cfg(target_os = "aros")]
+    aros_startup::quiet_dos();
     let args: Vec<OsString> = std::env::args_os().skip(1).collect();
     // Language packs installed in the suite's font store are used; `proof.installPack` installs
     // only while the person has turned downloading on in the app.
