+[package]
+name = "wordcraft-aros"
+description = "WordCraft on AROS: the egui interface in an Intuition window, through egui-aros"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+publish = false
+
+# The window, input, renderers, requesters, clipboard, character set and start-up data come
+# from egui-aros (shared by the Craft AROS ports); this crate has no `unsafe` code of its own.
+
+[lints.clippy]
+dbg_macro = "warn"
+todo = "warn"
+
+[[bin]]
+name = "WordCraft"
+path = "src/main.rs"
+
+[dependencies]
+wordcraft-doc = { workspace = true }
+wordcraft-engine = { workspace = true }
+wordcraft-proof = { workspace = true }
+wordcraft-fonts = { workspace = true }
+wordcraft-ui-egui = { workspace = true }
+wordcraft-control-key = { workspace = true }
+egui = { workspace = true, features = ["default_fonts"] }
+# Built from a pinned egui-aros commit with its crate patches: see the port's scripts/craft.py.
+# OpenGL is compiled in and chosen at run time (CPU, AUTO or GPU).
+egui-aros = { version = "0.1", features = ["asl", "glow"] }
+# Its minimum_stack! macro (egui_aros::startup is the same crate).
+aros-startup = "0.1"
+serde_json = { workspace = true }
+log = { workspace = true }
+# --screenshot writes PNG.
+image = { workspace = true }
+
+# The patched rayon-core (see the port's crate patches) can end the global pool's threads, which
+# AROS's pthread library otherwise waits for forever when the program exits.
+[target.'cfg(target_os = "aros")'.dependencies]
+rayon-core = "1.13"
