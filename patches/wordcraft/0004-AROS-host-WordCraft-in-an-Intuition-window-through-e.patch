new file mode 100644
index 0000000000000000000000000000000000000000..28d3cb74d2b6f335e08c569f735c22810ee8c717
--- /dev/null
+++ b/apps/wordcraft-aros/src/services.rs
@@ -0,0 +1,130 @@
+//! The platform services the editor uses on AROS: ASL file requesters, the system clipboard's
+//! text and pictures, the animation setting and the templates folder. The same contract as the
+//! desktop app's `services` (apps/wordcraft/src/main.rs), without rfd, arboard, craft-print and
+//! the other crates that have no AROS backend; the app hides what a missing service would offer
+//! (printing, rich clipboard formats, default-app registration).
+//!
+//! Paths: the program runs in the -nix path mode; requesters speak DOS names, converted at this
+//! edge (egui_aros::startup).
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use egui_aros::WindowHandle;
+use egui_aros::asl::{Select, request};
+use egui_aros::startup::{dos_to_nix, nix_to_dos};
+use wordcraft_ui_egui::Services;
+use wordcraft_ui_egui::paste_picture::ClipboardPicture;
+
+/// An AmigaDOS pattern for the first filter of `purpose` (`#?.(docx|odt)`), or none for "any
+/// file"; the ASL requester matches it without regard to case. asl.library copies the pattern
+/// into a 257-byte gadget without a length check (VectorCraft port), so a longer one shows every
+/// file instead.
+fn pattern(purpose: &str) -> String {
+    let Some((_, exts)) = wordcraft_ui_egui::open_filters(purpose).first() else { return String::new() };
+    if exts.contains(&"*") {
+        return String::new();
+    }
+    let p = format!("#?.({})", exts.join("|"));
+    if p.len() > 255 { String::new() } else { p }
+}
+
+/// The window the requesters are parented to, set once the window is open (the requester runs on
+/// the main thread, modally, while the loop is inside the service call). The handle holds the
+/// window weakly: after it closes, a requester opens without a parent.
+pub type SharedWindow = Rc<RefCell<Option<WindowHandle>>>;
+
+/// The file name part of a path (`a.png` for `/Work/Images/a.png`).
+fn file_part(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// The drawer part of a -nix path (`/Work/Images` for `/Work/Images/a.png`).
+fn dir_part(path: &str) -> &str {
+    match path.rfind('/') {
+        Some(0) | None => "",
+        Some(i) => &path[..i],
+    }
+}
+
+fn pick(window: &SharedWindow, select: Select, title: &str, dir: &str, file: &str, pat: &str) -> Option<String> {
+    let win = window.borrow().clone()?;
+    let start = if dir.is_empty() { String::new() } else { nix_to_dos(dir).unwrap_or_default() };
+    let dos = request(&win, select, title, &start, file, pat).into_iter().next()?;
+    match dos_to_nix(&dos) {
+        Ok(p) => Some(p),
+        Err(e) => {
+            log::warn!("requester: {dos}: {e}");
+            None
+        }
+    }
+}
+
+/// The picture on the clipboard, in the form the editor's Paste takes (`None`: no picture).
+pub fn clipboard_picture() -> Option<ClipboardPicture> {
+    match egui_aros::clipboard_image() {
+        egui_aros::ClipboardImage::None => None,
+        egui_aros::ClipboardImage::Pixels { width, height, rgba } => {
+            log::info!("clipboard picture: {width}x{height}");
+            Some(ClipboardPicture::Pixels { width: width as usize, height: height as usize, rgba })
+        }
+        egui_aros::ClipboardImage::Unreadable(why) => {
+            log::warn!("clipboard picture: {why}");
+            Some(ClipboardPicture::Unreadable(why))
+        }
+    }
+}
+
+/// The services for this host.
+pub fn aros(window: SharedWindow) -> Services {
+    let last_dir: Rc<RefCell<String>> = Rc::new(RefCell::new(String::new()));
+    let (open_window, save_window) = (window.clone(), window);
+    let (open_dir, save_dir) = (last_dir.clone(), last_dir);
+    Services {
+        pick_open: Some(Box::new(move |purpose: &str| {
+            let title = match purpose {
+                "picture" => "Insert Picture",
+                "font" => "Add Font",
+                "recipients" => "Select Recipients",
+                _ => "Open",
+            };
+            let dir = open_dir.borrow().clone();
+            let path = pick(&open_window, Select::Open, title, &dir, "", &pattern(purpose))?;
+            *open_dir.borrow_mut() = dir_part(&path).to_string();
+            Some(path)
+        })),
+        pick_save: Some(Box::new(move |suggested: &str| {
+            let (dir, file) = (dir_part(suggested).to_string(), file_part(suggested).to_string());
+            let dir = if dir.is_empty() { save_dir.borrow().clone() } else { dir };
+            let path = pick(&save_window, Select::Save, "Save As", &dir, &file, "")?;
+            *save_dir.borrow_mut() = dir_part(&path).to_string();
+            Some(path)
+        })),
+        clipboard_text: Some(Box::new(egui_aros::clipboard_text)),
+        clipboard_picture: Some(Box::new(clipboard_picture)),
+        // Animations are drawn frame by frame by the CPU renderer on most AROS systems; they are
+        // off unless the user turns them on in File › Options.
+        animations_enabled: Some(Box::new(|| Some(false))),
+        templates_dir: wordcraft_control_key::settings_dir().map(|d| d.join("Templates")),
+        ..Default::default()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn path_parts() {
+        assert_eq!(dir_part("/Work/Images/a.png"), "/Work/Images");
+        assert_eq!(file_part("/Work/Images/a.png"), "a.png");
+        assert_eq!(dir_part("/RAM"), "");
+        assert_eq!(dir_part("a.docx"), "");
+    }
+
+    #[test]
+    fn patterns_fit_the_requester() {
+        assert!(pattern("document").len() <= 255);
+        assert!(pattern("document").starts_with("#?.(") || pattern("document").is_empty());
+    }
+}
