-int32_t wc_debug_tasks(char *out, int32_t outlen);
-
-/* Diagnostics: every task exec knows of (this one, the ready and the waiting
- * ones) as "name|state|pri|sigwait|sigrecvd" lines. Used to see which threads
- * are still alive when the program exits: AROS's pthread library waits for
- * all of them. Returns the number of bytes written to `out`. */
-static int32_t append_task(char *out, int32_t outlen, int32_t len, struct Task *t, const char *state)
-{
-    int n;
-    if (len >= outlen - 1)
-        return len;
-    n = snprintf(out + len, outlen - len, "%s|%s|%d|%08lx|%08lx\n",
-                 t->tc_Node.ln_Name ? t->tc_Node.ln_Name : "?", state, (int)t->tc_Node.ln_Pri,
-                 (unsigned long)t->tc_SigWait, (unsigned long)t->tc_SigRecvd);
-    if (n < 0)
-        return len;
-    return len + n < outlen ? len + n : outlen - 1;
-}
-
-/* Words on a waiting pthread's stack that point into this program's code:
- * candidate return addresses, which the host maps to functions with nm after
- * subtracting the anchor's load offset. A heuristic stack scan, diagnostics only. */
-static int32_t append_stack(char *out, int32_t outlen, int32_t len, struct Task *t)
-{
-    IPTR lo = (IPTR)&wc_debug_tasks - 0x4000000, hi = (IPTR)&wc_debug_tasks + 0x4000000;
-    IPTR *sp = (IPTR *)t->tc_SPReg, *top = (IPTR *)t->tc_SPUpper;
-    int found = 0, n;
-    if (!sp || !top || sp >= top || top - sp > 65536)
-        return len;
-    for (; sp < top && found < 48 && len < outlen - 24; sp++) {
-        if (*sp >= lo && *sp < hi) {
-            n = snprintf(out + len, outlen - len, " %lx", (unsigned long)*sp);
-            if (n > 0)
-                len += n;
-            found++;
-        }
-    }
-    if (len < outlen - 1) {
-        out[len++] = '\n';
-        out[len] = 0;
-    }
-    return len;
-}
-
-int32_t wc_debug_tasks(char *out, int32_t outlen)
-{
-    struct Node *n;
-    int32_t len = 0;
-    if (!out || outlen < 2)
-        return 0;
-    out[0] = 0;
-    len = snprintf(out, outlen, "anchor wc_debug_tasks=%lx\n", (unsigned long)(IPTR)&wc_debug_tasks);
-    Forbid();
-    len = append_task(out, outlen, len, FindTask(NULL), "running");
-    for (n = SysBase->TaskReady.lh_Head; n->ln_Succ; n = n->ln_Succ)
-        len = append_task(out, outlen, len, (struct Task *)n, "ready");
-    for (n = SysBase->TaskWait.lh_Head; n->ln_Succ; n = n->ln_Succ) {
-        len = append_task(out, outlen, len, (struct Task *)n, "wait");
-        if (n->ln_Name && strncmp(n->ln_Name, "pthread", 7) == 0)
-            len = append_stack(out, outlen, len, (struct Task *)n);
-    }
-    Permit();
-    return len;
-}
