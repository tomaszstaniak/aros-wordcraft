--- a/crates/render/src/lib.rs
+++ b/crates/render/src/lib.rs
@@ -408,10 +408,34 @@ impl Default for RenderOptions {
 
 /// Render a whole page at `scale` pixels per point.
 pub fn render_page(doc: &Document, page: &Page, scale: f32, opts: &RenderOptions) -> Rendered {
+    #[cfg(not(target_arch = "wasm32"))]
+    let started = std::time::Instant::now();
     let scale = if scale.is_finite() && scale > 0.0 { scale } else { 1.0 };
     let w = ((page.w * scale).ceil() as u32).clamp(1, MAX_SIDE);
     let h = ((page.h.min(1e6) * scale).ceil() as u32).clamp(1, MAX_SIDE);
-    render_region(doc, page, w, h, Affine::scale(scale as f64), opts)
+    let out = render_region(doc, page, w, h, Affine::scale(scale as f64), opts);
+    #[cfg(not(target_arch = "wasm32"))]
+    perf::count(started.elapsed());
+    out
+}
+
+/// Page renders since the start, for a host that measures its responsiveness (the AROS shell):
+/// two relaxed counters, no locks, nothing logged.
+pub mod perf {
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    static RENDERS: AtomicU64 = AtomicU64::new(0);
+    static NANOS: AtomicU64 = AtomicU64::new(0);
+
+    pub(crate) fn count(took: std::time::Duration) {
+        RENDERS.fetch_add(1, Ordering::Relaxed);
+        NANOS.fetch_add(took.as_nanos().min(u64::MAX as u128) as u64, Ordering::Relaxed);
+    }
+
+    /// (page renders, nanoseconds spent in them) since the program started.
+    pub fn totals() -> (u64, u64) {
+        (RENDERS.load(Ordering::Relaxed), NANOS.load(Ordering::Relaxed))
+    }
 }
 
 /// Render a page into a `w`×`h` raster with `view` (page points → pixels).
