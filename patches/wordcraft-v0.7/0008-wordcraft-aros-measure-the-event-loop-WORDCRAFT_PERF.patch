diff --git a/apps/wordcraft-aros/src/perf.rs b/apps/wordcraft-aros/src/perf.rs
new file mode 100644
index 0000000000000000000000000000000000000000..798e45d0f7a8e1381d30d9e7a6c242fb522eefb3
--- /dev/null
+++ b/apps/wordcraft-aros/src/perf.rs
@@ -0,0 +1,90 @@
+//! Responsiveness measurement: one record per pass of the event loop, kept in memory and written
+//! once, at exit, to the file named by `WORDCRAFT_PERF` (CSV). Nothing is logged while the
+//! program runs, so the measurement does not slow what it measures.
+//!
+//! Times are microseconds. `wait` is the time asleep in `Window::wait`; the phases after it are
+//! the frame's work. An event's latency runs from Intuition's stamp on its message to the end of
+//! the blit of the frame that handled it, both in the system time of `ffi::systime_us`. F9 is
+//! taken by the shell as a scenario marker and not passed on; each press starts the next segment.
+
+use std::io::Write;
+
+#[derive(Clone, Copy, Default)]
+pub struct Frame {
+    pub segment: u32,
+    /// Since the program started (`Instant`).
+    pub at_us: u64,
+    pub wait_us: u32,
+    pub input_us: u32,
+    pub logic_us: u32,
+    pub ui_us: u32,
+    pub tess_us: u32,
+    pub textures_us: u32,
+    pub raster_us: u32,
+    pub blit_us: u32,
+    pub events: u16,
+    pub moves: u16,
+    pub keys: u16,
+    pub wheels: u16,
+    pub buttons: u16,
+    /// Youngest and oldest event of the frame, age at the end of its blit; -1 without events.
+    pub latency_min_us: i64,
+    pub latency_max_us: i64,
+    pub page_renders: u32,
+    pub page_render_us: u32,
+    /// Pixels of texture data uploaded this frame (page images, the font atlas).
+    pub texture_px: u64,
+    pub vertices: u32,
+    pub width: u16,
+    pub height: u16,
+}
+
+pub struct Perf {
+    path: std::path::PathBuf,
+    frames: Vec<Frame>,
+    pub segment: u32,
+}
+
+/// Records beyond this are dropped (about an hour at a few frames a second).
+const MAX_FRAMES: usize = 50_000;
+
+impl Perf {
+    pub fn from_env() -> Option<Perf> {
+        let path = std::env::var_os("WORDCRAFT_PERF").filter(|p| !p.is_empty())?;
+        Some(Perf { path: path.into(), frames: Vec::with_capacity(MAX_FRAMES), segment: 0 })
+    }
+
+    pub fn push(&mut self, frame: Frame) {
+        if self.frames.len() < MAX_FRAMES {
+            self.frames.push(frame);
+        }
+    }
+
+    pub fn write(&self) {
+        let result = (|| -> std::io::Result<()> {
+            let mut f = std::io::BufWriter::new(std::fs::File::create(&self.path)?);
+            writeln!(
+                f,
+                "segment,at_us,wait_us,input_us,logic_us,ui_us,tess_us,textures_us,raster_us,blit_us,events,moves,keys,wheels,buttons,latency_min_us,latency_max_us,page_renders,page_render_us,texture_px,vertices,width,height"
+            )?;
+            for r in &self.frames {
+                writeln!(
+                    f,
+                    "{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}",
+                    r.segment, r.at_us, r.wait_us, r.input_us, r.logic_us, r.ui_us, r.tess_us, r.textures_us, r.raster_us, r.blit_us,
+                    r.events, r.moves, r.keys, r.wheels, r.buttons, r.latency_min_us, r.latency_max_us, r.page_renders,
+                    r.page_render_us, r.texture_px, r.vertices, r.width, r.height
+                )?;
+            }
+            f.flush()
+        })();
+        if let Err(e) = result {
+            log::warn!("cannot write {}: {e}", self.path.display());
+        }
+    }
+}
+
+/// Microseconds of `d`, saturating.
+pub fn us(d: std::time::Duration) -> u32 {
+    d.as_micros().min(u32::MAX as u128) as u32
+}
