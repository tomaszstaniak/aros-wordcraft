@@ -0,0 +1,31 @@
+//! getrandom's custom backend for AROS.
+//!
+//! getrandom 0.3 and 0.4 have no AROS backend; builds for AROS select the custom one with
+//! `--cfg getrandom_backend="custom"`, and both versions then call the one
+//! `__getrandom_v03_custom` symbol defined here (their `Error` types have the same layout).
+//! It fills the buffer from `getentropy()`, which the AROS C library adaptation implements
+//! over a jitter entropy source and which fails instead of returning weak bytes.
+//! wordcraft-docx, the one user of getrandom, links it (`use wordcraft_aros_entropy as _;`).
+
+#[cfg(target_os = "aros")]
+mod aros {
+    /// # Safety
+    /// getrandom calls it with a valid, writable buffer of `len` bytes, possibly uninitialized.
+    #[unsafe(no_mangle)]
+    unsafe fn __getrandom_v03_custom(dest: *mut u8, len: usize) -> Result<(), getrandom::Error> {
+        // getentropy() takes at most 256 bytes per call. The buffer may be uninitialized,
+        // so it is only ever handled through raw pointers.
+        let mut offset = 0;
+        while offset < len {
+            let chunk = (len - offset).min(256);
+            // SAFETY: `offset + chunk <= len`, inside the caller's buffer.
+            if unsafe { libc::getentropy(dest.add(offset).cast(), chunk) } != 0 {
+                // SAFETY: the whole buffer is writable; leave no partial output behind.
+                unsafe { core::ptr::write_bytes(dest, 0, len) };
+                return Err(getrandom::Error::new_custom(1));
+            }
+            offset += chunk;
+        }
+        Ok(())
+    }
+}
